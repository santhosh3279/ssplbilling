{%- set parts = (document_name or '').split('||') -%}
{%- set party = parts[0] if parts|length > 0 else '' -%}
{%- set from_date = parts[1] if parts|length > 1 and parts[1] else '1900-01-01' -%}
{%- set to_date = parts[2] if parts|length > 2 and parts[2] else frappe.utils.nowdate() -%}
{%- set party_type = parts[3] if parts|length > 3 and parts[3] else 'Customer' -%}

{%- if party_type == 'Account' -%}
{%- set entries = frappe.db.sql("""
    SELECT posting_date, voucher_type, voucher_no, debit, credit
    FROM `tabGL Entry`
    WHERE account = %(party)s
      AND posting_date BETWEEN %(from_date)s AND %(to_date)s
      AND is_cancelled = 0
    ORDER BY posting_date, creation
""", {"party": party, "from_date": from_date, "to_date": to_date}, as_dict=True) -%}
{%- set ob = frappe.db.sql("""
    SELECT COALESCE(SUM(debit),0) AS d, COALESCE(SUM(credit),0) AS c
    FROM `tabGL Entry`
    WHERE account = %(party)s AND posting_date < %(from_date)s AND is_cancelled = 0
""", {"party": party, "from_date": from_date}, as_dict=True) -%}
{%- set party_label = frappe.db.get_value('Account', party, 'account_name') or party -%}
{%- else -%}
{%- set entries = frappe.db.sql("""
    SELECT posting_date, voucher_type, voucher_no, debit, credit
    FROM `tabGL Entry`
    WHERE party_type = %(party_type)s AND party = %(party)s
      AND posting_date BETWEEN %(from_date)s AND %(to_date)s
      AND is_cancelled = 0
    ORDER BY posting_date, creation
""", {"party_type": party_type, "party": party, "from_date": from_date, "to_date": to_date}, as_dict=True) -%}
{%- set ob = frappe.db.sql("""
    SELECT COALESCE(SUM(debit),0) AS d, COALESCE(SUM(credit),0) AS c
    FROM `tabGL Entry`
    WHERE party_type = %(party_type)s AND party = %(party)s
      AND posting_date < %(from_date)s AND is_cancelled = 0
""", {"party_type": party_type, "party": party, "from_date": from_date}, as_dict=True) -%}
{%- set party_label = frappe.db.get_value(party_type, party, party_type|lower ~ '_name') or party -%}
{%- endif -%}
{%- set opening = (ob[0].d or 0) - (ob[0].c or 0) -%}
[C][B][W2]LEDGER[/W2][/B]
[C][B]{{ party_label[:32] }}[/B]
[C]{{ party_type }} | {{ party[:32] }}
[C]{{ from_date }}  to  {{ to_date }}
[DLINE]
[L]Opening[R][B]{{ '{:,.2f}'.format(opening|abs) }} {{ 'Dr' if opening >= 0 else 'Cr' }}[/B]
[LINE]
{% set ns = namespace(bal=opening, tdr=0, tcr=0, n=0) -%}
{%- for e in entries -%}
{%- set ns.bal = ns.bal + (e.debit or 0) - (e.credit or 0) -%}
{%- set ns.tdr = ns.tdr + (e.debit or 0) -%}
{%- set ns.tcr = ns.tcr + (e.credit or 0) -%}
{%- set ns.n = ns.n + 1 -%}
{%- set ds = e.posting_date | string -%}
[B]{{ ds[8:10] }}/{{ ds[5:7] }}/{{ ds[2:4] }}[/B] {{ e.voucher_no[:26] }}
[L]{{ 'Dr ' ~ '{:,.2f}'.format(e.debit) if e.debit else 'Cr ' ~ '{:,.2f}'.format(e.credit) }}[R]{{ '{:,.2f}'.format(ns.bal|abs) }} {{ 'Dr' if ns.bal >= 0 else 'Cr' }}
{% endfor %}
{%- if ns.n == 0 %}
[C]-- no entries in this period --
{% endif %}[LINE]
[L]Total Debit[R]{{ '{:,.2f}'.format(ns.tdr) }}
[L]Total Credit[R]{{ '{:,.2f}'.format(ns.tcr) }}
[L]Entries[R]{{ ns.n }}
[DLINE]
[L][B][H2]CLOSING[/H2][/B][R][B][H2]{{ '{:,.2f}'.format(ns.bal|abs) }} {{ 'Dr' if ns.bal >= 0 else 'Cr' }}[/H2][/B]
[DLINE]
[C]Printed {{ frappe.utils.now_datetime().strftime('%d/%m/%Y %H:%M') }}
[FEED:2]
