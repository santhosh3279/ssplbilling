   "description": "1 to 28, so every month has the day."
  },
  {
   "depends_on": "eval:doc.frequency=='Custom Cron'",
   "fieldname": "cron_expression",
   "fieldtype": "Data",
   "label": "Cron Expression",
   "mandatory_depends_on": "eval:doc.frequency=='Custom Cron'",
   "description": "minute hour day-of-month month day-of-week, e.g. <code>30 21 * * 1-6</code> = 9:30 PM Monday to Saturday. Checked every 5 minutes."
  },
  {
   "default": "Same Day",
   "fieldname": "report_period",
   "fieldtype": "Select",
   "label": "Report For",
   "options": "Same Day\nPrevious Day",
   "description": "The day of the scheduled send, or the day before it (for a send after midnight)."
