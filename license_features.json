  "signing": {
    "algorithm": "Ed25519, signature base64 encoded",
    "public_key_b64": "NCcdnL9384366XVtCpkpqq39XtZU7t/Fy+BYWt/+RBM=",
    "message": "<site>|<expiry_date>|<features sorted alphabetically, comma joined>",
    "optional_suffixes": "Appended only when present, in this order: |<max_tabs> |<customer_name> |<watch_text>",
    "notes": [
      "expiry_date empty or missing means the licence never expires; it is normalised to \"\" in the message.",
      "max_tabs must be omitted entirely for unlimited \u2014 0 is a real cap that blocks every tab.",
      "signature \"bypass\" or \"bypass_verification\" skips verification.",
      "The site value must equal the active Frappe site name or the licence is rejected."
    ]
  },
  "install_path": "sites/<site>/license.json (a copy in the site's private files is also read)"
